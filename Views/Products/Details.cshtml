@model ProductInventoryTracker.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<table class="table table-bordered">

    <tr>
        <th>Product ID</th>
        <td>@Model.ProductId</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Quantity</th>
        <td>@Model.Quantity</td>
    </tr>

    <tr>
        <th>Price</th>
        <td>₹@Model.Price</td>
    </tr>

    <tr>
        <th>Created Date</th>
        <td>@Model.CreatedDate</td>
    </tr>

</table>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>
