@{
    ViewData["Title"] = "Dashboard";
}

<h2>Inventory Dashboard</h2>

<div class="row">

    <div class="col-md-6">

        <div class="card p-4 mb-3">

            <h4>Total Products</h4>

            <h2>@ViewBag.TotalProducts</h2>

        </div>

    </div>

    <div class="col-md-6">

        <div class="card p-4 mb-3">

            <h4>Total Stock Value</h4>

            <h2>₹@ViewBag.TotalStockValue</h2>

        </div>

    </div>

</div>

<a asp-action="Index"
   class="btn btn-primary">
    View Products
</a>
